# imyemail 部署环境变量示例
# 用法：cp deploy/.env.example deploy/.env，然后修改 deploy/.env。
# 注意：.env 里不要写引号；真实密码、Secret Key 不要提交到 Git。

# =========================
# Docker 镜像
# =========================
# 单容器部署镜像。默认使用你的 GHCR 镜像。
# 本地源码构建请用：docker compose -f docker-compose.yml -f docker-compose.build.yml up -d --build
IMYEMAIL_IMAGE=ghcr.io/logdns/imyemail:latest
# 内部在线更新/回滚运维镜像；不映射公网端口。
IMYEMAIL_OPERATOR_IMAGE=ghcr.io/logdns/imyemail-operator:latest
# 宿主机安装目录。一键安装会自动写入实际路径。
IMYEMAIL_INSTALL_DIR=/opt/imyemail

# 本地源码构建时的 Go 模块代理；无法访问 proxy.golang.org 的网络可改为 https://goproxy.cn,direct。
IMYEMAIL_BUILD_GOPROXY=https://proxy.golang.org,direct

# 多容器调试版镜像。只在 docker-compose.stack.yml 中使用。
IMYEMAIL_API_IMAGE=ghcr.io/logdns/imyemail-api:latest
IMYEMAIL_WEB_IMAGE=ghcr.io/logdns/imyemail-web:latest
IMYEMAIL_GATEWAY_IMAGE=ghcr.io/logdns/imyemail-gateway:latest
IMYEMAIL_POSTFIX_IMAGE=ghcr.io/logdns/imyemail-postfix:latest
IMYEMAIL_DOVECOT_IMAGE=ghcr.io/logdns/imyemail-dovecot:latest
IMYEMAIL_RSPAMD_IMAGE=ghcr.io/logdns/imyemail-rspamd:latest

# 后台“立即更新”使用的内部鉴权令牌。一键安装会自动生成，请勿对外公开。
# 手动部署可执行：openssl rand -hex 24
IMYEMAIL_UPDATE_TOKEN=

# 可选端口绑定。使用宿主机反向代理时，可将 HTTP 设为 127.0.0.1:8088。
IMYEMAIL_HTTP_BIND=80
IMYEMAIL_HTTPS_BIND=443
IMYEMAIL_SMTP_BIND=25
IMYEMAIL_SMTPS_BIND=465
IMYEMAIL_SUBMISSION_BIND=587
IMYEMAIL_IMAPS_BIND=993
IMYEMAIL_POP3S_BIND=995

# =========================
# 对外访问地址
# =========================
# 首次启动的网站名称、浏览器标题和界面模板；部署后也可在后台系统设置中修改。
IMYEMAIL_SITE_NAME=imyemail
IMYEMAIL_SITE_TITLE=imyemail
# 可选：imyemaildefault（经典）或 imyemailcloud（云端轻盈风格）。
IMYEMAIL_UI_TEMPLATE=imyemaildefault

# 邮件服务器主机名，一般填你的邮件域名，例如 mail.example.com。
# 会影响 Postfix myhostname、DNS 展示、邮件链接等。
IMYEMAIL_PUBLIC_HOSTNAME=mail.example.com

# Webmail 对外访问地址。生产环境建议使用 https。
IMYEMAIL_PUBLIC_BASE_URL=https://mail.example.com

# 邮件客户端 TLS 证书。用于 SMTP 465/587、IMAP 993、POP3 995。
# 托管证书目录。首次启动会生成 30 天临时自签证书；在后台启用 ACME 后会原子替换并自动重载 Web/Postfix/Dovecot。
IMYEMAIL_CERTIFICATE_DIR=/data/certificates
IMYEMAIL_TLS_CERT_FILE=/data/certificates/fullchain.pem
IMYEMAIL_TLS_KEY_FILE=/data/certificates/privkey.pem

# 后台自动证书的初始值；也可登录后台“系统设置 -> SSL 证书”修改。
# provider: letsencrypt / zerossl / google_trust_services。ZeroSSL 与 GTS 必须提供 EAB。
IMYEMAIL_CERTIFICATE_AUTO_ENABLED=false
IMYEMAIL_CERTIFICATE_PROVIDER=letsencrypt
IMYEMAIL_CERTIFICATE_EMAIL=
IMYEMAIL_CERTIFICATE_EAB_KID=
IMYEMAIL_CERTIFICATE_EAB_HMAC=
IMYEMAIL_CERTIFICATE_RENEW_BEFORE_DAYS=30

# =========================
# 初始管理员
# =========================
# 第一次启动时只创建管理员账号，不会自动创建同名邮箱或域名。
# 登录名不能使用邮箱地址，之后可在后台“账号”中修改。
IMYEMAIL_ADMIN_USERNAME=admin

# 生产环境必须改掉默认密码。
# 首次启动必填，至少 10 个字符；不要使用示例或常见密码。
IMYEMAIL_ADMIN_PASSWORD=

# =========================
# API / 数据存储
# =========================
# API 监听地址。单容器里由 Nginx 反代到 127.0.0.1:8080。
IMYEMAIL_ADDR=:8080

# 容器内数据目录。docker-compose.yml 已把宿主机 ./data 挂载到 /data。
IMYEMAIL_DATA_DIR=/data

# SQLite 数据库路径。
IMYEMAIL_DB_PATH=/data/imyemail.db

# Session Cookie 名称，一般不用改。
IMYEMAIL_COOKIE_NAME=imyemail_session

# 登录会话有效期，单位：小时。默认 168 小时，即 7 天。
IMYEMAIL_SESSION_TTL_HOURS=168

# 是否允许非 HTTPS 下的 Cookie。生产环境建议 false；本地 HTTP 调试可改 true。
IMYEMAIL_ALLOW_INSECURE_HTTP=false

# =========================
# 注册与安全
# =========================
# 是否开放用户自行注册。
IMYEMAIL_OPEN_REGISTRATION=false

# 是否启用 2FA 功能总开关。
IMYEMAIL_TWO_FACTOR_ENABLED=false

# 是否启用 Cloudflare Turnstile 人机验证。
IMYEMAIL_TURNSTILE_ENABLED=false

# Turnstile Site Key，前端公开使用。未启用时可以留空。
IMYEMAIL_TURNSTILE_SITE_KEY=

# Turnstile Secret Key，服务端校验使用。未启用时可以留空。
IMYEMAIL_TURNSTILE_SECRET_KEY=

# =========================
# SMTP 发信
# =========================
# 单容器部署默认提交给容器内 Postfix。
# Split stack 会由 docker-compose.stack.yml 默认覆盖为 postfix:25。
# 如需在 split stack 使用外部 SMTP，可设置 IMYEMAIL_STACK_SMTP_HOST / IMYEMAIL_STACK_SMTP_PORT。
# 如果要走外部 SMTP，把 Host/Port/Username/Password 改成外部服务配置。
IMYEMAIL_SMTP_HOST=127.0.0.1
IMYEMAIL_SMTP_PORT=25
IMYEMAIL_STACK_SMTP_HOST=
IMYEMAIL_STACK_SMTP_PORT=
IMYEMAIL_SMTP_USERNAME=
IMYEMAIL_SMTP_PASSWORD=

# 外部 SMTP 要求 STARTTLS / TLS 时改 true；本机 Postfix 默认 false。
IMYEMAIL_SMTP_REQUIRE_TLS=false

# 开放 API 最终投递事件回调的 HMAC-SHA256 密钥。生产环境请使用高强度随机值。
# 未配置时 /api/open/v1/delivery-events 返回 503。
IMYEMAIL_DELIVERY_WEBHOOK_SECRET=

# 可选：把发送队列与最终投递状态主动推送给外部系统。URL 默认必须为公网 HTTPS。
IMYEMAIL_STATUS_WEBHOOK_URL=
IMYEMAIL_STATUS_WEBHOOK_SECRET=
# 仅可信内网或本地测试可开启；开启后也允许 HTTP 与私网目标。
IMYEMAIL_STATUS_WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# 第三方客户端 SMTP 提交。all-in-one 默认启用 587/465；split stack 可按需填写 :587 / :465。
IMYEMAIL_SUBMISSION_ADDR=
IMYEMAIL_SUBMISSION_TLS_ADDR=
IMYEMAIL_SUBMISSION_MAX_MESSAGE_MB=35

# =========================
# 收件 / Maildir 同步
# =========================
# Dovecot Maildir 根目录。docker-compose.yml 已把 maildata 挂到这里。
IMYEMAIL_MAILDIR_ROOT=/var/mail/vhosts

# 扫描 Maildir 的间隔，单位：秒。
IMYEMAIL_MAILDIR_SCAN_SECONDS=30

# Rspamd 从 SQLite 导出 DKIM 私钥到签名目录的间隔，单位：秒。
IMYEMAIL_RSPAMD_DKIM_SYNC_SECONDS=60

# 无人收件开关。false：未注册邮箱默认拒收；true：未注册收件地址进入全部邮件。
IMYEMAIL_CATCH_ALL_ENABLED=false

# 用户是否可以在个人中心自助申请邮箱。
IMYEMAIL_USER_MAILBOX_APPLY_ENABLED=false

# 允许自助申请的域名 ID，多个用英文逗号分隔。建议在后台“系统设置 > 邮件”里配置。
IMYEMAIL_USER_MAILBOX_DOMAIN_IDS=

# 禁止自助申请的邮箱前缀，多个用英文逗号分隔。
IMYEMAIL_RESERVED_MAILBOX_PREFIXES=admin,postmaster,abuse,hostmaster,webmaster,root,security,noreply,no-reply,mailer-daemon

# Webmail 是否自动轮询刷新邮件。
IMYEMAIL_MAIL_AUTO_REFRESH=true

# 自动刷新间隔，单位：秒。
IMYEMAIL_MAIL_REFRESH_SECONDS=30

# 是否启用外部 IMAP 接入。也可在后台“系统设置 > 外部 IMAP”里开启，默认关闭。
IMYEMAIL_EXTERNAL_IMAP_ENABLED=false

# 外部 IMAP 密码加密密钥。启用外部 IMAP 接入前必须设置为足够长的随机字符串；也可在后台“系统设置 > 外部 IMAP”里配置。
IMYEMAIL_EXTERNAL_IMAP_SECRET_KEY=

# 外部 IMAP 本地存储模式的后台同步间隔，单位：秒；也可在后台配置。
IMYEMAIL_EXTERNAL_IMAP_SYNC_SECONDS=300

# 是否允许用户配置 localhost / 内网 / link-local IMAP 主机。默认 false，避免 SSRF 风险；也可在后台配置。
IMYEMAIL_EXTERNAL_IMAP_ALLOW_PRIVATE_HOSTS=false

# Gmail 外部 IMAP OAuth2。也可在后台配置。回调地址：${IMYEMAIL_PUBLIC_BASE_URL}/api/external-imap-oauth/gmail/callback
IMYEMAIL_EXTERNAL_IMAP_GMAIL_CLIENT_ID=
IMYEMAIL_EXTERNAL_IMAP_GMAIL_CLIENT_SECRET=

# Microsoft 365 / Outlook 外部 IMAP OAuth2。也可在后台配置。回调地址：${IMYEMAIL_PUBLIC_BASE_URL}/api/external-imap-oauth/outlook/callback
IMYEMAIL_EXTERNAL_IMAP_OUTLOOK_CLIENT_ID=
IMYEMAIL_EXTERNAL_IMAP_OUTLOOK_CLIENT_SECRET=

# =========================
# 系统
# =========================
# 容器时区。
TZ=Asia/Shanghai
# Postfix 读取 SQLite WAL/SHM 所用的共享组 GID（Debian postfix 默认 103）。
IMYEMAIL_DB_SHARED_GID=103
