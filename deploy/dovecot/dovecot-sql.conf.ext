sql_driver = sqlite
sqlite_path = /data/imyemail.db

passdb sql {
  default_password_scheme = BLF-CRYPT
  query = SELECT m.address AS user, CASE WHEN u.two_factor_enabled=1 THEN m.app_password_hash ELSE m.password_hash END AS password FROM mailboxes m JOIN users u ON u.id=m.user_id WHERE m.address = '%{user}' AND m.status = 'active' AND u.disabled=0 AND (u.two_factor_enabled=0 OR m.app_password_hash<>'')
}

userdb sql {
  query = SELECT '/var/mail/vhosts/' || d.name || '/' || m.local_part AS home, 'maildir' AS mail_driver, '/var/mail/vhosts/' || d.name || '/' || m.local_part || '/Maildir' AS mail_path, 5000 AS uid, 5000 AS gid, CAST(m.quota_mb AS TEXT) || 'M' AS quota_storage_size FROM mailboxes m JOIN domains d ON d.id=m.domain_id WHERE d.name=lower(substr('%{user}', instr('%{user}', '@') + 1)) AND m.local_part=lower(CASE WHEN instr(substr('%{user}', 1, instr('%{user}', '@') - 1), '+') > 0 THEN substr(substr('%{user}', 1, instr('%{user}', '@') - 1), 1, instr(substr('%{user}', 1, instr('%{user}', '@') - 1), '+') - 1) ELSE substr('%{user}', 1, instr('%{user}', '@') - 1) END) AND m.status='active' AND d.status='active' UNION SELECT '/var/mail/vhosts/' || lower(substr('%{user}', instr('%{user}', '@') + 1)) || '/__unregistered__' AS home, 'maildir' AS mail_driver, '/var/mail/vhosts/' || lower(substr('%{user}', instr('%{user}', '@') + 1)) || '/__unregistered__/Maildir' AS mail_path, 5000 AS uid, 5000 AS gid, '1024M' AS quota_storage_size WHERE EXISTS (SELECT 1 FROM system_settings WHERE key='catchAllEnabled' AND value='true') AND EXISTS (SELECT 1 FROM domains WHERE name=lower(substr('%{user}', instr('%{user}', '@') + 1)) AND status='active') AND NOT EXISTS (SELECT 1 FROM mailboxes m JOIN domains d ON d.id=m.domain_id WHERE d.name=lower(substr('%{user}', instr('%{user}', '@') + 1)) AND m.local_part=lower(CASE WHEN instr(substr('%{user}', 1, instr('%{user}', '@') - 1), '+') > 0 THEN substr(substr('%{user}', 1, instr('%{user}', '@') - 1), 1, instr(substr('%{user}', 1, instr('%{user}', '@') - 1), '+') - 1) ELSE substr('%{user}', 1, instr('%{user}', '@') - 1) END) AND m.status='active')
}
